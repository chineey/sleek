datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  author    String
  date      String
  image     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
