# Neon PostgreSQL database connection URL
DATABASE_URL="postgres://username:password@ep-host.region.pooler.neon.tech/neondb?sslmode=require"

# NextAuth configuration
NEXTAUTH_SECRET="your-nextauth-secret-key"
