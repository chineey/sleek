datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  author    String
  date      String
  image     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CoverSettings {
  id      Int    @id @default(1)
  title   String @default("SLEEK")
  issue   String @default("ISH. 01")
  label   String @default("MAGAZINE")
  tagline String @default("A New WAVE")
  url     String @default("www.sleekmagazine.com")
  social  String @default("@sleekpeak")
  image   String @default("https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1200&auto=format&fit=crop")
}

model Subscriber {
  id                 String   @id @default(uuid())
  email              String   @unique
  status             String   @default("inactive") // "active" | "inactive"
  paystackCustomerId String?
  paystackReference  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MagicLink {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DisplayName {
  id           String   @id @default(uuid())
  subscriberId String   @unique
  displayName  String   @unique // Stored in lowercase for case-insensitive comparison
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subscriberId])
}

model Comment {
  id               String   @id @default(uuid())
  articleId        Int
  subscriberId     String
  displayName      String   // Display name at time of comment
  content          String   @db.Text
  parentCommentId  String?  // For replies/threads
  createdAt        DateTime @default(now())

  @@index([articleId])
  @@index([subscriberId])
  @@index([parentCommentId])
}

